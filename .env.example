# LLM configuration
LLM_KEY=your_api_key_here
LLM_MODEL=your_model_name
# LLM_BASE_URL=https://api.example.com/v1

# Optional test defaults
TEST_BASE_URL=https://example.com
TEST_TIMEOUT=30000

# Optional login fallback credentials
# Recommended default:
# add plaintext credentials to your private requirement file:
#   - identifier: your_login_identifier
#   - password: your_login_password
# If the requirement file does not include plaintext credentials,
# the runner falls back to these values.
LOGIN_USERNAME=
LOGIN_PASSWORD=
LOGIN_PAGE_URL=https://global.lianlianpay.com/signin
LOGIN_SUCCESS_SIGNAL_VALUE=LianLian

# Logging
LOG_LEVEL=INFO
