{
  "test_cases": [
    {
      "id": "TC_001",
      "requirement_id": "REQ_001",
      "title": "验证使用有效关键词进行正常搜索",
      "priority": "high",
      "type": "functional",
      "steps": [
        {
          "step_number": 1,
          "action": "打开百度首页",
          "data": "https://www.baidu.com",
          "expected": "百度首页正常加载，搜索输入框可见"
        },
        {
          "step_number": 2,
          "action": "在搜索输入框中输入关键词",
          "data": "测试工程师",
          "expected": "输入框正确显示输入的关键词"
        },
        {
          "step_number": 3,
          "action": "点击“百度一下”按钮",
          "data": "N/A",
          "expected": "1. 页面发生跳转\n2. URL包含搜索参数\n3. 结果页面标题包含搜索关键词"
        }
      ],
      "expected": "搜索成功，页面跳转至结果页，并展示与关键词相关的搜索结果列表",
      "tags": [
        "smoke",
        "p1"
      ]
    },
    {
      "id": "TC_002",
      "requirement_id": "REQ_001",
      "title": "验证搜索输入框为空时的系统处理",
      "priority": "medium",
      "type": "functional",
      "steps": [
        {
          "step_number": 1,
          "action": "打开百度首页",
          "data": "https://www.baidu.com",
          "expected": "百度首页正常加载"
        },
        {
          "step_number": 2,
          "action": "保持搜索输入框为空，不做任何输入",
          "data": "N/A",
          "expected": "输入框保持空白状态"
        },
        {
          "step_number": 3,
          "action": "点击“百度一下”按钮",
          "data": "N/A",
          "expected": "页面刷新或保持首页状态，不跳转至错误页面"
        }
      ],
      "expected": "系统能够处理空输入请求，页面无报错，无异常跳转",
      "tags": [
        "boundary",
        "p2"
      ]
    },
    {
      "id": "TC_003",
      "requirement_id": "REQ_001",
      "title": "验证搜索特殊字符及URL编码跳转",
      "priority": "medium",
      "type": "functional",
      "steps": [
        {
          "step_number": 1,
          "action": "打开百度首页",
          "data": "https://www.baidu.com",
          "expected": "百度首页正常加载"
        },
        {
          "step_number": 2,
          "action": "在搜索输入框中输入特殊字符组合",
          "data": "@#￥%",
          "expected": "输入框正确显示输入的特殊字符"
        },
        {
          "step_number": 3,
          "action": "点击“百度一下”按钮",
          "data": "N/A",
          "expected": "1. 页面正常跳转\n2. URL参数中对特殊字符进行了正确的编码（如URL Encoding）"
        }
      ],
      "expected": "搜索功能支持特殊字符，页面正常跳转且无乱码或脚本执行错误",
      "tags": [
        "negative",
        "security",
        "p2"
      ]
    }
  ]
}