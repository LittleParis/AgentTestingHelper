{
  "test_cases": [
    {
      "id": "TC_001",
      "requirement_id": "REQ_001",
      "title": "验证使用有效关键词进行搜索并成功跳转",
      "priority": "high",
      "type": "functional",
      "steps": [
        {
          "step_number": 1,
          "action": "打开百度首页",
          "data": "https://www.baidu.com",
          "expected": "页面正常加载，标题显示为'百度一下，你就知道'"
        },
        {
          "step_number": 2,
          "action": "在【搜索输入框】中输入关键词",
          "data": "Selenium自动化测试",
          "expected": "输入框中正常显示输入的关键词"
        },
        {
          "step_number": 3,
          "action": "点击【百度一下搜索按钮】",
          "data": "N/A",
          "expected": "页面发生跳转"
        }
      ],
      "expected": "成功跳转到搜索结果页，页面标题包含搜索关键词，且结果列表中显示相关内容。",
      "tags": [
        "smoke",
        "positive"
      ]
    },
    {
      "id": "TC_002",
      "requirement_id": "REQ_001",
      "title": "验证搜索输入框为空时点击搜索按钮的处理",
      "priority": "medium",
      "type": "functional",
      "steps": [
        {
          "step_number": 1,
          "action": "打开百度首页",
          "data": "https://www.baidu.com",
          "expected": "页面正常加载"
        },
        {
          "step_number": 2,
          "action": "保持【搜索输入框】为空，不输入任何内容",
          "data": "N/A",
          "expected": "输入框保持空白状态"
        },
        {
          "step_number": 3,
          "action": "点击【百度一下搜索按钮】",
          "data": "N/A",
          "expected": "页面刷新或焦点停留在输入框"
        }
      ],
      "expected": "页面不跳转至错误页，通常刷新当前页或提示用户输入内容，输入框获得焦点。",
      "tags": [
        "negative",
        "boundary"
      ]
    },
    {
      "id": "TC_003",
      "requirement_id": "REQ_001",
      "title": "验证搜索特殊字符能否正常跳转",
      "priority": "medium",
      "type": "functional",
      "steps": [
        {
          "step_number": 1,
          "action": "打开百度首页",
          "data": "https://www.baidu.com",
          "expected": "页面正常加载"
        },
        {
          "step_number": 2,
          "action": "在【搜索输入框】中输入特殊符号",
          "data": "@#$%^&*()",
          "expected": "输入框正常显示特殊符号"
        },
        {
          "step_number": 3,
          "action": "点击【百度一下搜索按钮】",
          "data": "N/A",
          "expected": "页面发生跳转"
        }
      ],
      "expected": "成功跳转到搜索结果页，URL参数中对特殊字符进行了正确编码，页面无报错。",
      "tags": [
        "positive",
        "special_chars"
      ]
    }
  ]
}